{
	# TLS is the ingress's job, and nothing needs Caddy's admin API.
	auto_https off
	admin off
}

:8080 {
	root * /srv
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# For liveness and readiness probes.
	handle /healthz {
		respond "ok" 200
	}

	# Files here have a content hash in their names, so they never change. A
	# missing one is a real 404.
	@hashed path /_expo/static/* /assets/*
	handle @hashed {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}

	# Everything else is the app, which routes in the browser: a path that
	# isn't a file gets index.html. It's checked on every load, so a new
	# version shows up at once.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}
}
